# Copier ce fichier en .env.local (ignoré par Git) puis remplir.
# Ne jamais mettre de vraies valeurs dans ce fichier : il est versionné.
# Supabase > Project Settings > API Keys

# Utilisées par le site (publiques, protégées par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Utilisée uniquement par scripts/upload-images.mjs — SECRÈTE (sb_secret_… ou service_role)
SUPABASE_SERVICE_ROLE_KEY=
